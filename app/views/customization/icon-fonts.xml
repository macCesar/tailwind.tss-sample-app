<Alloy>
  <Window class="title-attributes-on-surface bar-surface nav-tint-accent android:display-home-as-up bg-surface" titleid="icons_title" backButtonTitle="">
    <ScrollView class="vertical content-h-auto content-w-screen w-screen">

      <!-- Section: Official Fonts -->
      <Label class="section" textid="icons_section_official" />

      <View class="card vertical">
        <Label class="mx-4 mt-4 h-auto text-sm text-on-surface" textid="icons_official_desc" />

        <Label class="mx-4 mt-4 text-sm font-semibold text-on-surface" textid="icons_fa_title" />
        <Label class="mx-4 mt-1 h-auto text-xs text-on-surface-variant" textid="icons_fa_desc" />

        <Label class="mx-4 mt-4 text-sm font-semibold text-on-surface" textid="icons_f7_title" />
        <Label class="mx-4 mt-1 h-auto text-xs text-on-surface-variant" textid="icons_f7_desc" />

        <Label class="mx-4 mt-4 text-sm font-semibold text-on-surface" textid="icons_mi_title" />
        <Label class="mx-4 mt-1 h-auto text-xs text-on-surface-variant" textid="icons_mi_desc" />

        <Label class="mx-4 mt-4 text-sm font-semibold text-on-surface" textid="icons_ms_title" />
        <Label class="mx-4 mb-4 mt-1 h-auto text-xs text-on-surface-variant" textid="icons_ms_desc" />
      </View>

      <!-- Section: Using Icons -->
      <Label class="section mt-6" textid="icons_section_usage" />

      <View class="card vertical">
        <Label class="mx-4 mt-4 text-sm font-semibold text-on-surface" textid="icons_usage_title" />
        <Label class="mx-4 mt-1 h-auto text-xs text-on-surface-variant" textid="icons_usage_desc" />

        <View class="horizontal mx-4 mt-4 h-auto w-screen">
          <Label class="fas fa-house text-2xl text-blue-400" />
          <Label class="ml-3 text-sm text-on-surface-variant">fas fa-house</Label>
        </View>

        <View class="horizontal mx-4 mt-3 h-auto w-screen">
          <Label class="fas fa-gear text-2xl text-green-400" />
          <Label class="ml-3 text-sm text-on-surface-variant">fas fa-gear</Label>
        </View>

        <View class="horizontal mx-4 mt-3 h-auto w-screen">
          <Label class="fas fa-heart text-2xl text-red-400" />
          <Label class="ml-3 text-sm text-on-surface-variant">fas fa-heart</Label>
        </View>

        <View class="horizontal mx-4 mb-4 mt-3 h-auto w-screen">
          <Label class="fab fa-github text-2xl text-on-surface-variant" />
          <Label class="ml-3 text-sm text-on-surface-variant">fab fa-github</Label>
        </View>
      </View>

      <!-- Section: Custom Font Libraries -->
      <Label class="section mt-6" textid="icons_section_custom" />

      <View class="card vertical">
        <Label class="mx-4 mt-4 text-sm font-semibold text-on-surface" textid="icons_custom_title" />
        <Label class="mx-4 mt-1 h-auto text-xs text-on-surface-variant" textid="icons_custom_desc" />

        <View class="mx-4 mt-4 h-auto w-screen">
          <TextArea class="h-auto w-screen rounded-lg bg-slate-900 p-2 font-mono text-xs text-green-400" readonly="true">
# 1. Put font files in purgetss/fonts/
purgetss/
└─ fonts/
   └─ boxicons/
      ├─ boxicons.css
      └─ boxicons.ttf

# 2. Run build-fonts
purgetss build-fonts
# alias: purgetss bf
          </TextArea>
          <Label class="fas fa-copy mt-0 mr-0 wh-8 text-center text-sm text-muted" onClick="copyCode" touchEnabled="true" />
        </View>

        <Label class="mx-4 mt-4 text-sm font-semibold text-on-surface" textid="rules_generated_output" />

        <View class="mx-4 mb-4 mt-4 h-auto w-screen">
          <TextArea class="h-auto w-screen rounded-lg bg-slate-900 p-2 font-mono text-xs text-slate-400" readonly="true">
// purgetss/styles/fonts.tss
'.boxicons': {
  font: { fontFamily: 'boxicons' }
}
'.bxl-meta': {
  text: '\uef27', title: '\uef27'
}
          </TextArea>
          <Label class="fas fa-copy mt-0 mr-0 wh-8 text-center text-sm text-muted" onClick="copyCode" touchEnabled="true" />
        </View>
      </View>

      <!-- Section: `modules` Option -->
      <Label class="section mt-6" textid="icons_section_modules" />

      <View class="card vertical">
        <Label class="mx-4 mt-4 text-sm font-semibold text-on-surface" textid="icons_modules_title" />
        <Label class="mx-4 mt-1 h-auto text-xs text-on-surface-variant" textid="icons_modules_desc" />

        <View class="mx-4 mt-4 h-auto w-screen">
          <TextArea class="h-auto w-screen rounded-lg bg-slate-900 p-2 font-mono text-xs text-cyan-400" readonly="true">
purgetss build-fonts --modules
# alias: purgetss bf -m
          </TextArea>
          <Label class="fas fa-copy mt-0 mr-0 wh-8 text-center text-sm text-muted" onClick="copyCode" touchEnabled="true" />
        </View>

        <View class="mx-4 mt-4 h-auto w-screen">
          <TextArea class="h-auto w-screen rounded-lg bg-slate-900 p-2 font-mono text-xs text-purple-400" readonly="true">
// app/lib/purgetss.fonts.js
const icons = {
  boxicons: {
    bxlMeta: '\uef27',
    bxLemon: '\uef28'
  }
}
exports.icons = icons
          </TextArea>
          <Label class="fas fa-copy mt-0 mr-0 wh-8 text-center text-sm text-muted" onClick="copyCode" touchEnabled="true" />
        </View>

        <Label class="mx-4 mb-4 mt-2 h-auto text-xs text-on-surface-variant" textid="icons_modules_usage" />
      </View>

      <!-- Section: Rename Prefix -->
      <Label class="section mt-6" textid="icons_section_prefix" />

      <View class="card vertical">
        <Label class="mx-4 mt-4 text-sm font-semibold text-on-surface" textid="icons_prefix_title" />
        <Label class="mx-4 mt-1 h-auto text-xs text-on-surface-variant" textid="icons_prefix_desc" />

        <View class="mx-4 mt-4 h-auto w-screen">
          <TextArea class="h-auto w-screen rounded-lg bg-slate-900 p-2 font-mono text-xs text-green-400" readonly="true">
# Rename lineicons.css → li.css
purgetss/fonts/lineicons/li.css

# Classes become:
'.li-zoom-out': { text: '\uea02' }
'.li-zoom-in': { text: '\uea03' }
          </TextArea>
          <Label class="fas fa-copy mt-0 mr-0 wh-8 text-center text-sm text-muted" onClick="copyCode" touchEnabled="true" />
        </View>

        <Label class="mx-4 mb-4 mt-2 h-auto text-xs text-amber-400" textid="icons_prefix_note" />
      </View>

      <!-- Section: Assets -->
      <Label class="section mt-6" textid="icons_section_assets" />

      <View class="card vertical">
        <Label class="mx-4 mt-4 h-auto text-sm text-on-surface" textid="icons_assets_desc" />
        <Label class="mx-4 mb-4 mt-2 h-auto text-xs text-on-surface-variant" textid="icons_assets_note" />
      </View>

      <View class="mb-8" />

    </ScrollView>
  </Window>
</Alloy>
