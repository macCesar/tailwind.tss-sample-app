<Alloy>
  <NavigationWindow id="navWin" class="bg-surface">
    <Window class="title-attributes-on-surface bar-surface nav-tint-accent android:display-home-as-up bg-surface" titleid="app_title">
      <ScrollView class="vertical content-h-auto content-w-screen show-vertical-scroll-indicator-false w-screen">

        <!-- Header -->
        <View class="mx-6 mb-1 mt-4 h-auto w-auto">
          <Label class="text-sm text-on-surface-variant" textid="app_version" />
        </View>

        <!-- Divider -->
        <View class="mx-6 mb-2 mt-4 h-1 w-auto bg-border" />

        <!-- Section: Dark Theme -->
        <View class="mx-6 mb-4 mt-2 h-auto w-auto">
          <Label class="text-sm text-on-surface-variant" textid="section_dark_theme" />
        </View>

        <!-- 1. Product Card (nike) -->
        <View class="mx-6 mb-3 h-auto w-screen rounded-xl bg-surface-high" onClick="openNike">
          <View class="wh-12 my-4 ml-4 rounded-lg bg-red-500/20">
            <Label class="text-xl font-bold text-red-400" text="▶" />
          </View>
          <View class="vertical my-4 ml-16 mr-0 h-auto w-screen">
            <Label class="text-base font-semibold text-on-surface" textid="card_product_card" />
            <Label class="mt-1 text-xs text-on-surface-variant" textid="desc_product_card" />
          </View>
        </View>

        <!-- 2. Project List (projects) -->
        <View class="mx-6 mb-3 h-auto w-screen rounded-xl bg-surface-high" onClick="openProjects">
          <View class="wh-12 my-4 ml-4 rounded-lg bg-indigo-500/20">
            <Label class="text-xl font-bold text-indigo-400" text="◆" />
          </View>
          <View class="vertical my-4 ml-16 mr-0 h-auto w-screen">
            <Label class="text-base font-semibold text-on-surface" textid="card_project_list" />
            <Label class="mt-1 text-xs text-on-surface-variant" textid="desc_project_list" />
          </View>
        </View>

        <!-- 3. Login Form (register) -->
        <View class="mx-6 mb-3 h-auto w-screen rounded-xl bg-surface-high" onClick="openRegister">
          <View class="wh-12 my-4 ml-4 rounded-lg bg-green-500/20">
            <Label class="text-xl font-bold text-green-400" text="~" />
          </View>
          <View class="vertical my-4 ml-16 mr-0 h-auto w-screen">
            <Label class="text-base font-semibold text-on-surface" textid="card_login_form" />
            <Label class="mt-1 text-xs text-on-surface-variant" textid="desc_login_form" />
          </View>
        </View>

        <!-- 4. Shadows & Depth (shadows) -->
        <View class="mx-6 mb-6 h-auto w-screen rounded-xl bg-surface-high" onClick="openShadows">
          <View class="wh-12 my-4 ml-4 rounded-lg bg-cyan-500/20">
            <Label class="text-xl font-bold text-cyan-400" text="◇" />
          </View>
          <View class="vertical my-4 ml-16 mr-0 h-auto w-screen">
            <Label class="text-base font-semibold text-on-surface" textid="card_shadows" />
            <Label class="mt-1 text-xs text-on-surface-variant" textid="desc_shadows" />
          </View>
        </View>

        <!-- Divider -->
        <View class="mx-6 mb-2 mt-2 h-1 w-auto bg-border" />

        <!-- Section: Light Theme -->
        <View class="mx-6 mb-4 mt-4 h-auto w-auto">
          <Label class="text-sm text-on-surface-variant" textid="section_light_theme" />
        </View>

        <!-- 5. Article Layout (politico) -->
        <View class="mx-6 mb-3 h-auto w-screen rounded-xl bg-surface-high" onClick="openPolitico">
          <View class="wh-12 my-4 ml-4 rounded-lg bg-amber-500/20">
            <Label class="text-xl font-bold text-amber-400" text="¶" />
          </View>
          <View class="vertical my-4 ml-16 mr-0 h-auto w-screen">
            <Label class="text-base font-semibold text-on-surface" textid="card_article_layout" />
            <Label class="mt-1 text-xs text-on-surface-variant" textid="desc_article_layout" />
          </View>
        </View>

        <!-- 6. Property Listing (house) -->
        <View class="mx-6 mb-3 h-auto w-screen rounded-xl bg-surface-high" onClick="openHouse">
          <View class="wh-12 my-4 ml-4 rounded-lg bg-blue-500/20">
            <Label class="text-xl font-bold text-blue-400" text="⌂" />
          </View>
          <View class="vertical my-4 ml-16 mr-0 h-auto w-screen">
            <Label class="text-base font-semibold text-on-surface" textid="card_property_listing" />
            <Label class="mt-1 text-xs text-on-surface-variant" textid="desc_property_listing" />
          </View>
        </View>

        <!-- 7. Settings Screen (settings) -->
        <View class="mx-6 mb-6 h-auto w-screen rounded-xl bg-surface-high" onClick="openSettings">
          <View class="wh-12 my-4 ml-4 rounded-lg bg-slate-500/20">
            <Label class="text-xl font-bold text-slate-400" text="≡" />
          </View>
          <View class="vertical my-4 ml-16 mr-0 h-auto w-screen">
            <Label class="text-base font-semibold text-on-surface" textid="card_settings_screen" />
            <Label class="mt-1 text-xs text-on-surface-variant" textid="desc_settings_screen" />
          </View>
        </View>

        <!-- Divider -->
        <View class="mx-6 mb-2 mt-2 h-1 w-auto bg-border" />

        <!-- Section: Customization -->
        <View class="mx-6 mb-4 mt-4 h-auto w-auto">
          <Label class="text-sm text-on-surface-variant" textid="section_customization" />
        </View>

        <!-- 8. The Config File -->
        <View class="mx-6 mb-3 h-auto w-screen rounded-xl bg-surface-high" onClick="openConfigFile">
          <View class="wh-12 my-4 ml-4 rounded-lg bg-purple-500/20">
            <Label class="text-xl font-bold text-purple-400" text="⚙" />
          </View>
          <View class="vertical my-4 ml-16 mr-0 h-auto w-screen">
            <Label class="text-base font-semibold text-on-surface" textid="card_config_file" />
            <Label class="mt-1 text-xs text-on-surface-variant" textid="desc_config_file" />
          </View>
        </View>

        <!-- 9. Custom Rules -->
        <View class="mx-6 mb-3 h-auto w-screen rounded-xl bg-surface-high" onClick="openCustomRules">
          <View class="wh-12 my-4 ml-4 rounded-lg bg-orange-500/20">
            <Label class="text-xl font-bold text-orange-400" text="✎" />
          </View>
          <View class="vertical my-4 ml-16 mr-0 h-auto w-screen">
            <Label class="text-base font-semibold text-on-surface" textid="card_custom_rules" />
            <Label class="mt-1 text-xs text-on-surface-variant" textid="desc_custom_rules" />
          </View>
        </View>

        <!-- 10. Apply Directive -->
        <View class="mx-6 mb-3 h-auto w-screen rounded-xl bg-surface-high" onClick="openApplyDirective">
          <View class="wh-12 my-4 ml-4 rounded-lg bg-teal-500/20">
            <Label class="text-xl font-bold text-teal-400" text="↻" />
          </View>
          <View class="vertical my-4 ml-16 mr-0 h-auto w-screen">
            <Label class="text-base font-semibold text-on-surface" textid="card_apply_directive" />
            <Label class="mt-1 text-xs text-on-surface-variant" textid="desc_apply_directive" />
          </View>
        </View>

        <!-- 11. Opacity Modifier -->
        <View class="mx-6 mb-3 h-auto w-screen rounded-xl bg-surface-high" onClick="openOpacityModifier">
          <View class="wh-12 my-4 ml-4 rounded-lg bg-pink-500/20">
            <Label class="text-xl font-bold text-pink-400" text="◐" />
          </View>
          <View class="vertical my-4 ml-16 mr-0 h-auto w-screen">
            <Label class="text-base font-semibold text-on-surface" textid="card_opacity_modifier" />
            <Label class="mt-1 text-xs text-on-surface-variant" textid="desc_opacity_modifier" />
          </View>
        </View>

        <!-- 12. Arbitrary Values -->
        <View class="mx-6 mb-3 h-auto w-screen rounded-xl bg-surface-high" onClick="openArbitraryValues">
          <View class="wh-12 my-4 ml-4 rounded-lg bg-emerald-500/20">
            <Label class="text-xl font-bold text-emerald-400" text="( )" />
          </View>
          <View class="vertical my-4 ml-16 mr-0 h-auto w-screen">
            <Label class="text-base font-semibold text-on-surface" textid="card_arbitrary_values" />
            <Label class="mt-1 text-xs text-on-surface-variant" textid="desc_arbitrary_values" />
          </View>
        </View>

        <!-- 13. Platform Modifiers -->
        <View class="mx-6 mb-3 h-auto w-screen rounded-xl bg-surface-high" onClick="openPlatformModifiers">
          <View class="wh-12 my-4 ml-4 rounded-lg bg-sky-500/20">
            <Label class="text-xl font-bold text-sky-400" text="⊞" />
          </View>
          <View class="vertical my-4 ml-16 mr-0 h-auto w-screen">
            <Label class="text-base font-semibold text-on-surface" textid="card_platform_modifiers" />
            <Label class="mt-1 text-xs text-on-surface-variant" textid="desc_platform_modifiers" />
          </View>
        </View>

        <!-- 14. Icon Font Libraries -->
        <View class="mx-6 mb-6 h-auto w-screen rounded-xl bg-surface-high" onClick="openIconFonts">
          <View class="wh-12 my-4 ml-4 rounded-lg bg-violet-500/20">
            <Label class="text-xl font-bold text-violet-400" text="★" />
          </View>
          <View class="vertical my-4 ml-16 mr-0 h-auto w-screen">
            <Label class="text-base font-semibold text-on-surface" textid="card_icon_fonts" />
            <Label class="mt-1 text-xs text-on-surface-variant" textid="desc_icon_fonts" />
          </View>
        </View>

        <!-- Divider -->
        <View class="mx-6 mb-2 mt-2 h-1 w-auto bg-border" />

        <!-- Section: More Examples -->
        <View class="mx-6 mb-4 mt-4 h-auto w-auto">
          <Label class="text-sm text-on-surface-variant" textid="section_more_examples" />
        </View>

        <View class="mx-6 mb-6 h-auto w-screen rounded-xl bg-surface-high opacity-60">
          <View class="wh-12 my-4 ml-4 rounded-lg bg-gray-500/20">
            <Label class="text-xl font-bold text-muted" text="…" />
          </View>
          <View class="vertical my-4 ml-16 mr-0 h-auto w-screen">
            <Label class="text-base font-semibold text-muted" textid="desc_coming_soon" />
          </View>
        </View>

      </ScrollView>
    </Window>
  </NavigationWindow>
</Alloy>
