<Alloy>
  <Window class="title-attributes-on-surface bar-surface nav-tint-accent android:display-home-as-up bg-surface" titleid="shadows_title" backButtonTitle="">
    <ScrollView class="vertical content-h-auto content-w-screen w-screen">

      <!-- Shadow Levels -->
      <Label class="section mt-6" textid="shadows_section_levels" />

      <View class="horizontal wh-auto mb-4">
        <View class="vertical wh-auto mx-1 mb-4">
          <View class="shadow-xs wh-16 m-4 rounded-lg bg-surface-high" />
          <Label class="mt-1 text-center text-xs text-muted" text="xs" />
        </View>
        <View class="vertical wh-auto mx-1 mb-4">
          <View class="wh-16 m-4 rounded-lg bg-surface-high shadow-sm" />
          <Label class="mt-1 text-center text-xs text-muted" text="sm" />
        </View>
        <View class="vertical wh-auto mx-1 mb-4">
          <View class="wh-16 m-4 rounded-lg bg-surface-high shadow" />
          <Label class="mt-1 text-center text-xs text-muted" text="base" />
        </View>
        <View class="vertical wh-auto mx-1 mb-4">
          <View class="wh-16 m-4 rounded-lg bg-surface-high shadow-md" />
          <Label class="mt-1 text-center text-xs text-muted" text="md" />
        </View>
        <View class="vertical wh-auto mx-1 mb-4">
          <View class="wh-16 m-4 rounded-lg bg-surface-high shadow-lg" />
          <Label class="mt-1 text-center text-xs text-muted" text="lg" />
        </View>
        <View class="vertical wh-auto mx-1 mb-4">
          <View class="wh-16 m-4 rounded-lg bg-surface-high shadow-xl" />
          <Label class="mt-1 text-center text-xs text-muted" text="xl" />
        </View>
        <View class="vertical wh-auto mx-1 mb-4">
          <View class="wh-16 m-4 rounded-lg bg-surface-high shadow-2xl" />
          <Label class="mt-1 text-center text-xs text-muted" text="2xl" />
        </View>
        <View class="vertical wh-auto mx-1 mb-4">
          <View class="wh-16 shadow-outline m-4 rounded-lg bg-surface-high" />
          <Label class="mt-1 text-center text-xs text-muted" text="outline" />
        </View>
      </View>

      <!-- Opacity -->
      <Label class="section" textid="shadows_section_opacity" />

      <View class="horizontal mx-3 mb-4 h-auto w-screen">
        <View class="vertical wh-auto mx-1 mb-4">
          <View class="wh-16 rounded-lg bg-blue-500/100" />
          <Label class="mt-1 text-center text-xs text-muted" text="100" />
        </View>
        <View class="vertical wh-auto mx-1 mb-4">
          <View class="wh-16 rounded-lg bg-blue-500/80" />
          <Label class="mt-1 text-center text-xs text-muted" text="80" />
        </View>
        <View class="vertical wh-auto mx-1 mb-4">
          <View class="wh-16 rounded-lg bg-blue-500/60" />
          <Label class="mt-1 text-center text-xs text-muted" text="60" />
        </View>
        <View class="vertical wh-auto mx-1 mb-4">
          <View class="wh-16 rounded-lg bg-blue-500/40" />
          <Label class="mt-1 text-center text-xs text-muted" text="40" />
        </View>
        <View class="vertical wh-auto mx-1 mb-4">
          <View class="wh-16 rounded-lg bg-blue-500/20" />
          <Label class="mt-1 text-center text-xs text-muted" text="20" />
        </View>
      </View>

      <!-- Border Radius -->
      <Label class="section" textid="shadows_section_radius" />

      <View class="horizontal mx-3 mb-4 h-auto w-screen">
        <View class="vertical wh-auto mx-1 mb-4">
          <View class="wh-16 rounded-none bg-blue-500" />
          <Label class="mt-1 text-center text-xs text-muted" text="none" />
        </View>
        <View class="vertical wh-auto mx-1 mb-4">
          <View class="wh-16 rounded bg-blue-500" />
          <Label class="mt-1 text-center text-xs text-muted" text="base" />
        </View>
        <View class="vertical wh-auto mx-1 mb-4">
          <View class="wh-16 rounded-lg bg-blue-500" />
          <Label class="mt-1 text-center text-xs text-muted" text="lg" />
        </View>
        <View class="vertical wh-auto mx-1 mb-4">
          <View class="wh-16 rounded-xl bg-blue-500" />
          <Label class="mt-1 text-center text-xs text-muted" text="xl" />
        </View>
        <View class="vertical wh-auto mx-1 mb-4">
          <View class="wh-16 rounded-2xl bg-blue-500" />
          <Label class="mt-1 text-center text-xs text-muted" text="2xl" />
        </View>
        <View class="vertical wh-auto mx-1 mb-4">
          <View class="wh-16 rounded-3xl bg-blue-500" />
          <Label class="mt-1 text-center text-xs text-muted" text="3xl" />
        </View>
        <View class="vertical wh-auto mx-1 mb-4">
          <View class="rounded-full-16 bg-blue-500" />
          <Label class="mt-1 text-center text-xs text-muted" text="full" />
        </View>
      </View>

    </ScrollView>
  </Window>
</Alloy>
