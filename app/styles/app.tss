// Ti Elements
'Button[platform=android]': { backgroundColor: 'transparent' }
'ImageView[platform=ios]': { hires: true }
'Label': { touchEnabled: false }
'ScrollView': { contentWidth: Ti.UI.FILL, contentHeight: Ti.UI.SIZE }
'ScrollView[platform=android]': { scrollType: 'vertical' }
'TextArea': { touchEnabled: false }
'View': { width: Ti.UI.SIZE, height: Ti.UI.SIZE }
'Window': { backgroundColor: '#FFFFFF' }
'Window[platform=ios]': { autoAdjustScrollViewInsets: true, extendEdges: [ Ti.UI.EXTEND_EDGE_ALL ], largeTitleEnabled: true, statusBarStyle: Ti.UI.iOS.StatusBar.LIGHT_CONTENT }

// Custom Styles
'.actionBtn': { borderRadius: 8, bottom: 8, color: '#ffffff', textColor: '#ffffff', height: 32, right: 8, width: 80, font: { fontSize: 12, fontWeight: 'semibold' } }
'.cardDark': { backgroundColor: '#1e293b', borderRadius: 12, bottom: 16, height: Ti.UI.SIZE, right: 16, left: 16, width: Ti.UI.FILL }
'.cardLight': { backgroundColor: 'surfaceHighColor', borderRadius: 12, bottom: 16, height: Ti.UI.SIZE, right: 16, left: 16, viewShadowOffset: { x: 0, y: 1 }, viewShadowRadius: 2, viewShadowColor: '#80000000', elevation: 8, width: Ti.UI.FILL }
'.fieldDark': { backgroundColor: '#334155', borderColor: '#475569', borderRadius: 8, color: '#ffffff', textColor: '#ffffff', height: 40, top: 4, width: Ti.UI.FILL, padding: { left: 12 }, font: { fontSize: 16 } }
'.section': { bottom: 4, color: '#64748b', textColor: '#64748b', height: Ti.UI.SIZE, right: 16, left: 16, top: 16, font: { fontSize: 12, fontWeight: 'semibold' } }

// Main Styles
